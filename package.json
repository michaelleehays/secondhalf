{
  "name": "second-half",
  "private": true,
  "description": "Second Half: a habit app framed as a life game, from 42 to 84.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace @second-half/web",
    "test": "vitest run",
    "build": "npm run build --workspace @second-half/web",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "type": "module"
}
